# Salin jadi .env lalu isi seperlunya. JANGAN commit file .env.
# Bot ini TIDAK butuh API key Bybit (cuma data publik).

# --- Output opsional ---
# Telegram: buat bot di @BotFather, ambil token; chat id dari @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook generik (POST JSON per sinyal), kosongkan kalau tidak dipakai
WEBHOOK_URL=

# --- Filter & aturan (default = hasil backtest) ---
MIN_TURNOVER_USD=5e6
MIN_AGE_DAYS=30
LATE_PCT=3
# 0 = kirim semua sinyal; isi angka untuk batasi sinyal per candle 1H (urut score tertinggi)
MAX_ALERTS_PER_HOUR=0
SL_PCT=0.08
TP1_PCT=0.03
TP2_PCT=0.05
MAX_LEVERAGE=5

# --- Zona waktu tampilan ---
TZ_OFFSET_HOURS=7
TZ_NAME=WIB
